# SDK_IMAGE and SDK_VERSION have no defaults here. `make` passes the SDK
# image tag it built and sdk_version from sdk.lock.yaml:
#   apptainer build --build-arg SDK_IMAGE=<tag> \
#       --build-arg SDK_VERSION=<sdk_version> \
#       riscv-ime-sdk-openchip-v<sdk_version>.sif build/sdk/sdk.def
# Without --build-arg, apptainer stops with "build var ... is not defined".
Bootstrap: docker-daemon
From: {{ SDK_IMAGE }}

%labels
    Author   openchip.com
    Version  v{{ SDK_VERSION }}
    MyLabel  OpenChip {{ SDK_VERSION }} IME tools

%help
    Container with toolchains, sysroot and emulators for IME Option G development.
    This installation is based on Ubuntu 26.04.

    Sources and build recipe: https://github.com/Openchip-Software/riscv-ime-sdk

%environment
    export RISCV_SYSROOT=/opt/openchip/toolchain/riscv64-openchip-linux-gnu/sysroot
    export PATH=/opt/openchip/toolchain/bin:/opt/openchip/qemu/bin:$PATH
    export QEMU_LD_PREFIX=/opt/openchip/toolchain/riscv64-openchip-linux-gnu/sysroot
    export QEMU_CPU=max,x-zvvm=true,vlen=2048
