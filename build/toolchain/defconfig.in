# defconfig.in — crosstool-NG configuration TEMPLATE, rendered by the
# Dockerfile in this directory from the build args in pins.hcl.
# Placeholders: @GCC_URL@ @GCC_REVISION@ @BINUTILS_URL@ @BINUTILS_REVISION@ @PKGVERSION@
CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_DEBUG_CT=y
CT_PREFIX_DIR="/opt/openchip/toolchain"
# CT_RM_RF_PREFIX_DIR is not set
# CT_PREFIX_DIR_RO is not set
CT_LOG_TO_FILE=y
# CT_LOG_FILE_COMPRESS is not set
# CT_LOG_PROGRESS_BAR is not set
CT_ARCH_RISCV=y
CT_ARCH_USE_MMU=y
CT_ARCH_64=y
# CT_SHOW_CT_VERSION is not set
CT_TOOLCHAIN_PKGVERSION="@PKGVERSION@"
CT_TARGET_VENDOR="openchip"
CT_KERNEL_LINUX=y
CT_BINUTILS_SRC_DEVEL=y
CT_BINUTILS_DEVEL_URL="@BINUTILS_URL@"
# Pin the exact commit, not the branch.
CT_BINUTILS_DEVEL_REVISION="@BINUTILS_REVISION@"
CT_BINUTILS_PLUGINS=y
CT_BINUTILS_EXTRA_CONFIG_ARRAY="--with-priv-spec=1.13"
CT_GLIBC_USE_LIBIDN_ADDON=y
CT_GLIBC_KERNEL_VERSION_CHOSEN=y
CT_GLIBC_MIN_KERNEL_VERSION="4.15.0"
CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_URL="@GCC_URL@"
CT_GCC_DEVEL_REVISION="@GCC_REVISION@"
CT_CC_GCC_LIBMUDFLAP=y
CT_CC_GCC_LIBGOMP=y
CT_CC_GCC_LIBSSP=y
CT_CC_GCC_LIBQUADMATH=y
CT_CC_GCC_LIBSANITIZER=y
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
CT_GDB_NATIVE=y
CT_GDB_NATIVE_STATIC=y
CT_COMP_LIBS_CLOOG=y
CT_GMP_EXTRA_CFLAGS=""
CT_COMP_LIBS_LIBELF=y
# CT_NCURSES_NEW_ABI is not set
CT_NCURSES_EXTRA_CFLAGS=""
