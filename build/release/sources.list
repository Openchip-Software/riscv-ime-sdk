#
# sources.list — upstream release tarballs that scripts/build-sdk.sh builds
# outside crosstool-NG, pinned by SHA-256. One line per tarball:
#
#   <name> <version> <sha256> <url>
#
# Every tarball here goes into the SDK source tarball as-is.
#
#   zlib, libffi, pcre2, glib, pixman  host libraries of QEMU. glib is
#                                      also linked by QEMU TCG plugins.
#   python                             embedded in the cross gdb
#   meson                              builds glib and pixman
#   patchelf                           sets relative RUNPATHs; not shipped
#
# glib and pixman SHA-256 values match the checksums published upstream.
zlib     1.3.2   bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16 https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz
libffi   3.8.0   7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4 https://github.com/libffi/libffi/releases/download/v3.8.0/libffi-3.8.0.tar.gz
pcre2    10.49   53c156e1ba416a20da8e65395daa132da0d80e76910424caca3fcdae7831d384 https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.49/pcre2-10.49.tar.bz2
glib     2.90.1  93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396 https://download.gnome.org/sources/glib/2.90/glib-2.90.1.tar.xz
pixman   0.46.4  a098c33924754ad43f981b740f6d576c70f9ed1006e12221b1845431ebce1239 https://cairographics.org/releases/pixman-0.46.4.tar.xz
python   3.14.9  e02d9ac21cebda6e46435369744a92c65cc7cd8669697694122cf97ffacd1e53 https://www.python.org/ftp/python/3.14.9/Python-3.14.9.tar.xz
meson    1.12.1  ab0a6ca09f8ef70c564c8241fb5a23957886a0b53fb58412b5e07eaf07dba743 https://github.com/mesonbuild/meson/releases/download/1.12.1/meson-1.12.1.tar.gz
patchelf 0.19.2  d4ad9a4e5c689e09119ce2f30a94b0e8b4f98c78590123ea21665e34c6928801 https://github.com/NixOS/patchelf/releases/download/0.19.2/patchelf-0.19.2.tar.bz2
